# READ_ONLY_INTAKE WhatsApp mode — sample env.
#
# Copy this file into your real ~/.hermes/.env (or load it for the
# wa-intake systemd unit). Do NOT commit it with real values.
#
# Mode invariants:
#   - WHATSAPP_READ_ONLY_INTAKE=true is the master switch. When set, ALL
#     outbound WhatsApp operations are blocked at three layers
#     (HTTP middleware, Baileys socket wrap, Python adapter early-return).
#   - WHATSAPP_MODE=self-chat + empty/unset WHATSAPP_ALLOWED_USERS is the
#     safest pilot configuration. Self-chat mode + secure-default empty
#     allowlist means ONLY the SD's messages to themselves reach the
#     intake store.
#   - Never set WHATSAPP_ALLOWED_USERS=* during pilot. It opens the bridge
#     to every inbound contact, defeating the allowlist gate.

# Master switch — flip to false (or unset) to disable READ_ONLY_INTAKE mode.
WHATSAPP_READ_ONLY_INTAKE=true

# Operating mode. 'self-chat' = SD only writes to themselves.
WHATSAPP_MODE=self-chat

# Allowlist — empty (default) = reject all inbound from non-self.
WHATSAPP_ALLOWED_USERS=

# Bridge port (loopback-only).
WHATSAPP_BRIDGE_PORT=3000

# ── Intake store policy ───────────────────────────────────────────────────
# Per-chat row retention (in rows). Oldest rows pruned at sweep time.
WHATSAPP_INTAKE_PER_CHAT_LIMIT=500

# Global row retention (in days). Rows older than this are deleted.
WHATSAPP_INTAKE_RETENTION_DAYS=30

# Maximum body length stored per message (in characters). Longer messages
# are truncated with a visible "…[truncated]" marker.
WHATSAPP_INTAKE_BODY_MAX=4096

# Media cache retention (in days). Files in ~/.hermes/*_cache older than
# this are deleted by the sweep. Metadata rows are marked 'expired'.
WHATSAPP_INTAKE_MEDIA_RETENTION_DAYS=7

# ── Anti-flag — must remain unset for SD-grade pilot ───────────────────────
# WHATSAPP_ALLOW_ALL_USERS=true     ← do NOT enable in pilot
# WHATSAPP_DEBUG=true               ← only enable when actively debugging
